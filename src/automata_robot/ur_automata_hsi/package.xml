<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_automata_hsi</name>
  <version>0.1.0</version>
  <description>
    Hyperspectral (HSI) measurement after the 3D scan: on a start message the
    robot moves the HSI above the object (north pole of the scan sphere), asks
    the HSI app for the measurement, waits for it, goes back home and reports
    done.
  </description>
  <maintainer email="do.park@iit.it">Do Won Park</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ur_automata_scan</depend>
  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>std_msgs</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>ur_automata_bringup</exec_depend>
  <exec_depend>ur_automata_description</exec_depend>
  <exec_depend>ur_automata_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
