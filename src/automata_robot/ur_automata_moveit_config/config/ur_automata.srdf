<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur_automata">
    <group name="ur_manipulator">
        <chain base_link="base_link" tip_link="ee_automata_tcp"/>
    </group>
    <group_state name="home" group="ur_manipulator">
        <joint name="elbow_joint" value="-2.2689"/>
        <joint name="shoulder_lift_joint" value="-0.5236"/>
        <joint name="shoulder_pan_joint" value="-1.571"/>
        <joint name="wrist_1_joint" value="1.2217"/>
        <joint name="wrist_2_joint" value="1.5708"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <group_state name="up" group="ur_manipulator">
        <joint name="elbow_joint" value="0"/>
        <joint name="shoulder_lift_joint" value="-1.571"/>
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="wrist_1_joint" value="0"/>
        <joint name="wrist_2_joint" value="1.571"/>
        <joint name="wrist_3_joint" value="-1.571"/>
    </group_state>
    <group_state name="lower_scan_ready" group="ur_manipulator">
        <joint name="elbow_joint" value="1.571"/>
        <joint name="shoulder_lift_joint" value="-1.571"/>
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="wrist_1_joint" value="0"/>
        <joint name="wrist_2_joint" value="1.571"/>
        <joint name="wrist_3_joint" value="-1.571"/>
    </group_state>
    <!-- Home of the wall-mounted robot (base roll -90 deg): only with that base pose. -->
    <group_state name="home_wall" group="ur_manipulator">
        <joint name="elbow_joint" value="-1.2217"/>
        <joint name="shoulder_lift_joint" value="0"/>
        <joint name="shoulder_pan_joint" value="-1.5708"/>
        <joint name="wrist_1_joint" value="-0.5236"/>
        <joint name="wrist_2_joint" value="1.5708"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <!-- Standard UR5e adjacent pairs (always disabled) -->
    <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent" />
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />
    <!-- Non-adjacent pairs that never collide in the sampled configurations -->
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never" />
    <!-- Custom tool (ee_automata_mesh_link) pairs -->
    <disable_collisions link1="ee_automata_mesh_link" link2="wrist_3_link" reason="Adjacent" />
    <disable_collisions link1="ee_automata_mesh_link" link2="wrist_1_link" reason="Never" />
    <disable_collisions link1="ee_automata_mesh_link" link2="wrist_2_link" reason="Never" />
</robot>
